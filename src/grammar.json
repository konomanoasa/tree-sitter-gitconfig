{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "gitconfig",
  "rules": {
    "document": {
      "type": "REPEAT",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "section"
          },
          {
            "type": "SYMBOL",
            "name": "blank_line"
          },
          {
            "type": "SYMBOL",
            "name": "comment"
          }
        ]
      }
    },
    "section": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "_section_start"
          },
          {
            "type": "FIELD",
            "name": "header",
            "content": {
              "type": "SYMBOL",
              "name": "section_header"
            }
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "variable"
                },
                {
                  "type": "SYMBOL",
                  "name": "blank_line"
                },
                {
                  "type": "SYMBOL",
                  "name": "comment"
                },
                {
                  "type": "SYMBOL",
                  "name": "line_ending"
                },
                {
                  "type": "SYMBOL",
                  "name": "_eof"
                }
              ]
            }
          }
        ]
      }
    },
    "section_header": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "opening",
          "content": {
            "type": "SYMBOL",
            "name": "section_open"
          }
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "section_name"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "subsection",
              "content": {
                "type": "SYMBOL",
                "name": "subsection"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "FIELD",
          "name": "closing",
          "content": {
            "type": "SYMBOL",
            "name": "section_close"
          }
        }
      ]
    },
    "section_name": {
      "type": "SYMBOL",
      "name": "_name"
    },
    "variable_name": {
      "type": "SYMBOL",
      "name": "_name"
    },
    "_name": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_name_start"
        },
        {
          "type": "SYMBOL",
          "name": "name_text"
        },
        {
          "type": "SYMBOL",
          "name": "_name_end"
        }
      ]
    },
    "subsection": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_quoted_subsection"
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "subsection_separator"
            },
            {
              "type": "CHOICE",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "subsection_text"
                },
                {
                  "type": "BLANK"
                }
              ]
            },
            {
              "type": "SYMBOL",
              "name": "_subsection_end"
            }
          ]
        }
      ]
    },
    "_quoted_subsection": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "opening",
          "content": {
            "type": "SYMBOL",
            "name": "quote_open"
          }
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "subsection_text"
              },
              {
                "type": "SYMBOL",
                "name": "escape"
              }
            ]
          }
        },
        {
          "type": "FIELD",
          "name": "closing",
          "content": {
            "type": "SYMBOL",
            "name": "quote_close"
          }
        }
      ]
    },
    "variable": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_variable_start"
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "variable_name"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "FIELD",
                  "name": "operator",
                  "content": {
                    "type": "SYMBOL",
                    "name": "assignment_operator"
                  }
                },
                {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "FIELD",
                      "name": "value",
                      "content": {
                        "type": "SYMBOL",
                        "name": "value"
                      }
                    },
                    {
                      "type": "BLANK"
                    }
                  ]
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "comment"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "line_ending"
            },
            {
              "type": "SYMBOL",
              "name": "_eof"
            }
          ]
        }
      ]
    },
    "value": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_value_start"
        },
        {
          "type": "REPEAT1",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "quoted_value"
              },
              {
                "type": "SYMBOL",
                "name": "_value_piece"
              }
            ]
          }
        },
        {
          "type": "SYMBOL",
          "name": "_value_end"
        }
      ]
    },
    "_value_piece": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "value_text"
        },
        {
          "type": "SYMBOL",
          "name": "escape"
        },
        {
          "type": "SYMBOL",
          "name": "line_continuation"
        }
      ]
    },
    "quoted_value": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "opening",
          "content": {
            "type": "SYMBOL",
            "name": "quote_open"
          }
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_value_piece"
          }
        },
        {
          "type": "FIELD",
          "name": "closing",
          "content": {
            "type": "SYMBOL",
            "name": "quote_close"
          }
        }
      ]
    },
    "comment": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_comment_start"
        },
        {
          "type": "SYMBOL",
          "name": "comment_marker"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "comment_text"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "line_ending"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_comment_end"
        }
      ]
    },
    "blank_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_blank_start"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "line_ending"
            },
            {
              "type": "SYMBOL",
              "name": "_eof"
            }
          ]
        }
      ]
    },
    "_unmatchable": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "PATTERN",
            "value": "[\\s\\S]"
          },
          {
            "type": "PATTERN",
            "value": "[^\\s\\S]"
          }
        ]
      }
    }
  },
  "extras": [
    {
      "type": "SYMBOL",
      "name": "_line_start"
    },
    {
      "type": "SYMBOL",
      "name": "_layout"
    },
    {
      "type": "SYMBOL",
      "name": "_unmatchable"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [
    {
      "type": "SYMBOL",
      "name": "_line_start"
    },
    {
      "type": "SYMBOL",
      "name": "_section_start"
    },
    {
      "type": "SYMBOL",
      "name": "_blank_start"
    },
    {
      "type": "SYMBOL",
      "name": "_variable_start"
    },
    {
      "type": "SYMBOL",
      "name": "_comment_start"
    },
    {
      "type": "SYMBOL",
      "name": "_comment_end"
    },
    {
      "type": "SYMBOL",
      "name": "_name_start"
    },
    {
      "type": "SYMBOL",
      "name": "_name_end"
    },
    {
      "type": "SYMBOL",
      "name": "_value_start"
    },
    {
      "type": "SYMBOL",
      "name": "_value_end"
    },
    {
      "type": "SYMBOL",
      "name": "_layout"
    },
    {
      "type": "SYMBOL",
      "name": "_eof"
    },
    {
      "type": "SYMBOL",
      "name": "line_ending"
    },
    {
      "type": "SYMBOL",
      "name": "section_open"
    },
    {
      "type": "SYMBOL",
      "name": "section_close"
    },
    {
      "type": "SYMBOL",
      "name": "name_text"
    },
    {
      "type": "SYMBOL",
      "name": "subsection_text"
    },
    {
      "type": "SYMBOL",
      "name": "value_text"
    },
    {
      "type": "SYMBOL",
      "name": "quote_open"
    },
    {
      "type": "SYMBOL",
      "name": "quote_close"
    },
    {
      "type": "SYMBOL",
      "name": "assignment_operator"
    },
    {
      "type": "SYMBOL",
      "name": "comment_marker"
    },
    {
      "type": "SYMBOL",
      "name": "comment_text"
    },
    {
      "type": "SYMBOL",
      "name": "escape"
    },
    {
      "type": "SYMBOL",
      "name": "line_continuation"
    },
    {
      "type": "SYMBOL",
      "name": "subsection_separator"
    },
    {
      "type": "SYMBOL",
      "name": "_subsection_end"
    },
    {
      "type": "SYMBOL",
      "name": "_error_sentinel"
    }
  ],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}